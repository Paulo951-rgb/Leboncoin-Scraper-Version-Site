{
  "name": "leboncoin-scraper-app",
  "version": "1.0.0",
  "description": "Application de scraping Leboncoin semi-automatisée",
  "main": "src/main/main.js",
  "productName": "Leboncoin Scraper Pro",
  "appId": "com.leboncoin.scraper.pro",
  "scripts": {
    "start": "electron --max-old-space-size=8192 .",
    "start:web": "node src/server/index.js",
    "test": "node test/regression.test.js",
    "test:server": "node test/server.test.js",
    "test:all": "node test/regression.test.js && node test/server.test.js",
    "coverage": "c8 node test/regression.test.js",
    "browsers": "node tools/prepare-browsers.js",
    "browsers:win": "node tools/prepare-browsers.js --platform=win",
    "icon": "python3 tools/generate-icon.py",
    "hf:prepare": "node tools/prepare-hf-space.js",
    "prepack": "node tools/prepare-browsers.js",
    "pack": "electron-builder --dir",
    "predist": "node tools/prepare-browsers.js --platform=win",
    "dist": "electron-builder --win",
    "prebuild": "node tools/prepare-browsers.js --platform=win",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "playwright": "1.41.2"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "com.leboncoin.scraper.pro",
    "productName": "Leboncoin Scraper Pro",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "!node_modules/playwright-core/.local-browsers/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leboncoin Scraper Pro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Leboncoin-Scraper-Pro-Portable-${version}.exe"
    }
  }
}
