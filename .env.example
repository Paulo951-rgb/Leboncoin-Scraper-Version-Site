# Leboncoin Scraper Pro — version Web
# Copier en `.env` pour le développement local. Ne JAMAIS committer de vraies valeurs.

# Serveur
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Stockage (dossier racine des données Web : base, jobs, sessions, logs)
LBC_BASE_OUT_DIR=./output
# Chemin explicite de la base SQLite (défaut : <LBC_BASE_OUT_DIR>/web/app.db)
# LBC_DB_PATH=./output/web/app.db

# Authentification
# 1 = désactiver l'auth (DEV UNIQUEMENT), 0 = activée
LBC_AUTH_DISABLED=1
# Secret de signature des sessions (OBLIGATOIRE en production)
# LBC_SESSION_SECRET=changez-moi-par-une-valeur-aleatoire-longue
LBC_ALLOW_SIGNUP=1

# Limites de ressources / sécurité
LBC_MAX_JOBS_PER_USER=2
LBC_GLOBAL_CONCURRENCY=2
LBC_MAX_PAGES=50
LBC_MAX_ADS=5000
LBC_JOB_TIMEOUT_MS=1800000
LBC_MAX_BODY_BYTES=65536
LBC_LOG_BUFFER=3000

# Rétention (jours) — 0 = conservation illimitée
LBC_JOB_RETENTION_DAYS=30
LBC_HAR_RETENTION_DAYS=2

# Scraping
LBC_HEADLESS=1
# 1 = autoriser une fenêtre visible pour résoudre un CAPTCHA (nécessite un
# écran ; impossible sur un serveur headless).
LBC_ALLOW_VISIBLE_CAPTCHA=0
LBC_SPEED=moyen
LBC_PAGE_DELAY_MS=1200
